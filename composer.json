{
    "name": "humanmade/button-block-icon",
    "description": "Puts an icon beside the label on core/button, chosen from a registered icon collection or uploaded as a one-off SVG.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Human Made Limited",
            "email": "engineering@humanmade.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^1 || ^2"
    },
    "require-dev": {
        "humanmade/coding-standards": "^2.5",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "format": "phpcbf"
    }
}
