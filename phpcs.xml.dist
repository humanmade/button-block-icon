<?xml version="1.0"?>
<ruleset name="button-block-icon">
	<description>PHP Coding Standards for Button Block Icon</description>

	<config name="php_version" value="80300"/>
	<config name="testVersion" value="8.3-"/>

	<arg value="s"/>
	<arg name="extensions" value="php"/>

	<file>button-block-icon.php</file>
	<file>inc</file>

	<exclude-pattern>*/vendor/</exclude-pattern>
	<exclude-pattern>*/node_modules/</exclude-pattern>
	<exclude-pattern>*/build/</exclude-pattern>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="HM">
		<!-- Don't restrict namespaced functions to `namespace.php`. -->
		<exclude name="HM.Files.FunctionFileName.WrongFile"/>
		<!-- Don't force namespace Foo_Bar into directory foo_bar. -->
		<exclude name="HM.Files.NamespaceDirectoryName"/>
		<!-- Allow short `@var` notation. -->
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
		<!-- Faulty sniff still bundled in the HM standard. -->
		<exclude name="PSR2R.Namespaces.UseInAlphabeticalOrder.Order"/>
	</rule>

	<!-- A plugin's entry file necessarily defines symbols and bootstraps. -->
	<rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
		<exclude-pattern>button-block-icon.php</exclude-pattern>
	</rule>
</ruleset>
